# Packing Conveyor — environment (EXAMPLE)
# Copy to .env and fill in real values. .env is git-ignored.
# Source: PRD_v2 sections 7.3, 9, 10.
#
# The anon key is public by design (RLS protects the data). The service_role key
# MUST NEVER appear here or anywhere in the repo/app — it lives only inside the
# deployed Edge Function environment.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
