// Packing Conveyor — firmware secrets (EXAMPLE)
// Source: PRD_v2 section 6.1 / 9 / 10.
//
// Copy this file to secrets.h (which is git-ignored) and fill in real values.
// NEVER commit secrets.h, Wi-Fi passwords, or the device token.

#pragma once

// --- Wi-Fi ---
#define WIFI_SSID       "your-hotspot-ssid"
#define WIFI_PASSWORD   "your-hotspot-password"

// --- Supabase cloud sync ---
// https://<project-ref>.supabase.co/functions/v1/device-sync
#define SUPABASE_FUNCTION_URL "https://YOUR-PROJECT-REF.supabase.co/functions/v1/device-sync"

// --- Device identity (from supabase/seed/create_device.sql output) ---
#define DEVICE_ID       "00000000-0000-0000-0000-000000000000"
#define DEVICE_TOKEN    "PLAIN-DEVICE-TOKEN-PRINTED-BY-THE-SEED-SCRIPT"

// --- Firmware version reported to the cloud ---
#define FW_VERSION      "2.0.0"
